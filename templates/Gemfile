# frozen_string_literal: true

source "https://rubygems.org"

# Web server and router.
gem "sinatra", "~> 4.0"
gem "rackup", "~> 2.0"
gem "puma", "~> 8.0"

# Database: Sequel over SQLite. The database file is created on first boot.
gem "sequel", "~> 5.90"
gem "sqlite3", "~> 2.1"

# Views and icons (icons render server-side as inline SVG).
gem "phlex", "~> 2.4"
gem "phlex-icons-huge", "~> 2.56"
