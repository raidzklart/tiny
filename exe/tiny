#!/usr/bin/env ruby
# frozen_string_literal: true

# tiny — one command to a minimal, runnable, database-backed SaaS starting point.
#
#   tiny new myapp
#
# Creates myapp/ with exactly app.rb, Gemfile, and .gitignore, then runs
# bundle install, git init, and one initial commit.
#
#   --skip-install  skip bundle install
#   --skip-git      skip git init and the initial commit

require "fileutils"

TEMPLATES_DIR = File.expand_path("../templates", __dir__)

# Template file (inside templates/) => written file (inside the new project).
# The templates directory holds exactly these three files.
TEMPLATES = {
  "app.rb"    => "app.rb",
  "Gemfile"   => "Gemfile",
  "gitignore" => ".gitignore",
}.freeze

FLAGS = {
  "--skip-install" => :skip_install,
  "--skip-git"     => :skip_git,
}.freeze

USAGE = <<~USAGE
  tiny — minimal Ruby SaaS app bootstrapper

  Usage:
    tiny new <name> [--skip-install] [--skip-git]

  Commands:
    new <name>        Create <name>/ containing app.rb, Gemfile, and .gitignore,
                      then run bundle install, git init, and one initial commit.
    help, --help      Show this help.

  Flags:
    --skip-install    Skip bundle install.
    --skip-git        Skip git init and the initial commit.

  Requires only Ruby and Bundler. No Node.js.
USAGE

def fail_with(message)
  warn "tiny: #{message}"
  exit 1
end

def print_usage(stream)
  stream.puts USAGE
  stream == $stdout ? exit(0) : exit(1)
end

def new_command(args)
  flags = []
  name = nil

  args.each do |arg|
    if (flag = FLAGS[arg])
      flags << flag
    elsif arg.start_with?("-")
      fail_with "unknown flag #{arg} for `tiny new`"
    elsif name
      fail_with "unexpected argument #{arg}"
    else
      name = arg
    end
  end

  fail_with "missing app name — usage: tiny new <name>" if name.nil?
  validate_name!(name)

  target = File.expand_path(name, Dir.pwd)

  if File.exist?(target) && (!File.directory?(target) || !Dir.empty?(target))
    fail_with "#{target} already exists and is not empty; nothing was written"
  end

  write_templates!(target)
  puts "tiny: created #{name}/ with app.rb, Gemfile, and .gitignore"

  run_bundle_install!(target) unless flags.include?(:skip_install)
  run_git_init!(target) unless flags.include?(:skip_git)

  puts
  puts "Done. Start your app:"
  puts "  cd #{name} && ruby app.rb"
end

def validate_name!(name)
  fail_with "app name cannot be empty" if name.strip.empty?
  return unless name.include?("/") || name.include?("\\") || name.match?(/\A\.+\z/)

  fail_with "app name cannot be a path: #{name}"
end

def write_templates!(target)
  fail_with "templates directory not found: #{TEMPLATES_DIR}" unless File.directory?(TEMPLATES_DIR)

  TEMPLATES.each_key do |source|
    path = File.join(TEMPLATES_DIR, source)
    fail_with "missing template: #{path}" unless File.file?(path)
  end

  FileUtils.mkdir_p(target)
  TEMPLATES.each do |source, destination|
    FileUtils.cp(File.join(TEMPLATES_DIR, source), File.join(target, destination))
  end
rescue SystemCallError => e
  fail_with "could not write into #{target}: #{e.message}"
end

def run_bundle_install!(target)
  puts "tiny: running bundle install…"
  return if system("bundle", "install", chdir: target)

  fail_with "bundle install failed. Fix the error, then run `bundle install` inside #{target}"
end

def run_git_init!(target)
  quiet = { out: File::NULL, err: File::NULL }
  unless system("git", "init", chdir: target, **quiet)
    warn "tiny: git is not available; skipped git init"
    return
  end

  system("git", "add", "-A", chdir: target, **quiet)
  if system("git", "commit", "-q", "-m", "Initial commit", chdir: target, **quiet)
    puts "tiny: initialized git repository with an initial commit"
  else
    warn "tiny: could not commit (git user.name/user.email not set?)."
    warn "tiny: set them, then run `git commit -m \"Initial commit\"` inside #{target}"
  end
end

command = ARGV.shift
case command
when "new" then new_command(ARGV)
when nil, "help", "--help", "-h" then print_usage($stdout)
else
  warn "tiny: unknown command: #{command}\n\n"
  print_usage($stderr)
end
